{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FrederikLive/ADP-Observatory/blob/main/schema/scan-report.schema.json",
  "title": "ADP-Observatory scan report",
  "type": "object",
  "required": [
    "schema_version",
    "analyzer_version",
    "target",
    "scan_complete",
    "files_examined",
    "files_skipped",
    "adp_markers",
    "limitations",
    "work_index",
    "compatibility",
    "context",
    "scan_scope",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "analyzer_version": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "scan_complete": {
      "type": "boolean"
    },
    "files_examined": {
      "type": "integer",
      "minimum": 0
    },
    "files_skipped": {
      "type": "integer",
      "minimum": 0
    },
    "adp_markers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_index": {
      "type": "object",
      "required": [
        "status",
        "project",
        "active_contract",
        "contract_count",
        "findings",
        "contract_files",
        "reference_inspection_limited",
        "contracts"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "INVALID",
            "STRUCTURALLY_VALID",
            "UNSUPPORTED_SCHEMA"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "message",
              "source"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "contract_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "contract_id",
              "source",
              "path",
              "status",
              "detail"
            ],
            "properties": {
              "contract_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PRESENT",
                  "MISSING",
                  "SYMLINK",
                  "OUTSIDE_ROOT",
                  "INVALID_PATH",
                  "NOT_FILE",
                  "NOT_DIRECTORY",
                  "UNREADABLE"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "reference_inspection_limited": {
          "type": "boolean"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "status",
              "workstream",
              "depends_on",
              "contract_file"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "workstream": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contract_file": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "format",
        "semantics",
        "conformance",
        "protocol",
        "semantic_scope"
      ],
      "properties": {
        "format": {
          "enum": [
            "READABLE",
            "INVALID",
            "NOT_PRESENT",
            "UNREADABLE"
          ]
        },
        "semantics": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "CONFLICT",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        },
        "conformance": {
          "const": "NOT_ASSESSED"
        },
        "protocol": {
          "type": "object",
          "required": [
            "status",
            "value",
            "sources",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "KNOWN",
                "UNKNOWN",
                "CONFLICT"
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "version"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "semantic_scope": {
          "const": "WORK_JSON_SCHEMA_V1_ONLY"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "records",
        "active_contract_claims",
        "conflicts"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "state",
              "limitation"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "MISSING",
                  "READABLE",
                  "UNREADABLE"
                ]
              },
              "limitation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "active_contract_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "line",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "claims"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "line",
                    "value"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 2
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scan_scope": {
      "type": "object",
      "required": [
        "status",
        "ignored_entries",
        "symlinks_excluded",
        "oversized_files_excluded",
        "nonregular_excluded",
        "metadata_errors",
        "directory_errors",
        "depth_limit_hits",
        "entry_limit_hits"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "COMPLETE_WITH_EXCLUSIONS",
            "PARTIAL"
          ]
        },
        "ignored_entries": {
          "type": "integer",
          "minimum": 0
        },
        "symlinks_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "oversized_files_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "nonregular_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_errors": {
          "type": "integer",
          "minimum": 0
        },
        "directory_errors": {
          "type": "integer",
          "minimum": 0
        },
        "depth_limit_hits": {
          "type": "integer",
          "minimum": 0
        },
        "entry_limit_hits": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "rule_version",
        "delivery",
        "references",
        "dependencies",
        "independently_verified",
        "historical_trend"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "type": "object",
          "required": [
            "state",
            "completed",
            "applicable",
            "cancelled_excluded",
            "percent",
            "statuses",
            "workstreams",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "KNOWN",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "applicable": {
              "type": "integer",
              "minimum": 0
            },
            "cancelled_excluded": {
              "type": "integer",
              "minimum": 0
            },
            "percent": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "statuses": {
              "type": "object",
              "required": [
                "verified",
                "underway",
                "blocked",
                "planned",
                "cancelled"
              ],
              "properties": {
                "verified": {
                  "type": "integer",
                  "minimum": 0
                },
                "underway": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                },
                "planned": {
                  "type": "integer",
                  "minimum": 0
                },
                "cancelled": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "workstreams": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "statuses",
                  "applicable",
                  "percent"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "statuses": {
                    "type": "object",
                    "required": [
                      "verified",
                      "underway",
                      "blocked",
                      "planned",
                      "cancelled"
                    ],
                    "properties": {
                      "verified": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "underway": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "blocked": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "planned": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "cancelled": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  },
                  "applicable": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "percent": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            },
            "source": {
              "type": "string"
            }
          }
        },
        "references": {
          "type": "object",
          "required": [
            "state",
            "expected",
            "inspected",
            "present",
            "missing",
            "denied_or_unsupported",
            "percent",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "KNOWN",
                "PARTIAL",
                "NOT_ASSESSED",
                "NOT_APPLICABLE"
              ]
            },
            "expected": {
              "type": "integer",
              "minimum": 0
            },
            "inspected": {
              "type": "integer",
              "minimum": 0
            },
            "present": {
              "type": "integer",
              "minimum": 0
            },
            "missing": {
              "type": "integer",
              "minimum": 0
            },
            "denied_or_unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "percent": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "source": {
              "type": "string"
            }
          }
        },
        "dependencies": {
          "type": "object",
          "required": [
            "state",
            "declared_edges",
            "pending_by_recorded_status",
            "details",
            "omitted_details",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "KNOWN",
                "PARTIAL",
                "UNKNOWN"
              ]
            },
            "declared_edges": {
              "type": "integer",
              "minimum": 0
            },
            "pending_by_recorded_status": {
              "type": "integer",
              "minimum": 0
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "contract_id",
                  "depends_on",
                  "target_recorded_status"
                ],
                "additionalProperties": false,
                "properties": {
                  "contract_id": {
                    "type": "string"
                  },
                  "depends_on": {
                    "type": "string"
                  },
                  "target_recorded_status": {
                    "type": "string"
                  }
                }
              }
            },
            "omitted_details": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "type": "string"
            }
          }
        },
        "independently_verified": {
          "const": "NOT_ASSESSED"
        },
        "historical_trend": {
          "const": "NOT_ASSESSED"
        }
      }
    }
  },
  "additionalProperties": false
}
