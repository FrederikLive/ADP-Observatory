{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FrederikLive/ADP-Observatory/blob/main/schema/scan-report.schema.json",
  "title": "ADP-Observatory scan report",
  "type": "object",
  "required": [
    "schema_version",
    "analyzer_version",
    "target",
    "scan_complete",
    "files_examined",
    "files_skipped",
    "adp_markers",
    "limitations",
    "work_index",
    "compatibility",
    "context"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "analyzer_version": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "scan_complete": {
      "type": "boolean"
    },
    "files_examined": {
      "type": "integer",
      "minimum": 0
    },
    "files_skipped": {
      "type": "integer",
      "minimum": 0
    },
    "adp_markers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_index": {
      "type": "object",
      "required": [
        "status",
        "project",
        "active_contract",
        "contract_count",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "INVALID",
            "STRUCTURALLY_VALID",
            "UNSUPPORTED_SCHEMA"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "message",
              "source"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "format",
        "semantics",
        "conformance",
        "protocol",
        "semantic_scope"
      ],
      "properties": {
        "format": {
          "enum": [
            "READABLE",
            "INVALID",
            "NOT_PRESENT",
            "UNREADABLE"
          ]
        },
        "semantics": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "CONFLICT",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        },
        "conformance": {
          "const": "NOT_ASSESSED"
        },
        "protocol": {
          "type": "object",
          "required": [
            "status",
            "value",
            "sources",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "KNOWN",
                "UNKNOWN",
                "CONFLICT"
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "version"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "semantic_scope": {
          "const": "WORK_JSON_SCHEMA_V1_ONLY"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "records",
        "active_contract_claims",
        "conflicts"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "state",
              "limitation"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "MISSING",
                  "READABLE",
                  "UNREADABLE"
                ]
              },
              "limitation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "active_contract_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "line",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "claims"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "line",
                    "value"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 2
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
